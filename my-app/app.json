{
  "expo": {
    "name": "HOSTELL",
    "slug": "my-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/assets/Hostell_Logo.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F3FBF7",
        "foregroundImage": "./assets/images/assets/Hostell_Logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.myapp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/assets/Hostell_Logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3FBF7",
          "image": "./assets/images/assets/Hostell_Logo.png",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "HOSTELL uses your location to fill in your property's address."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "HOSTELL needs access to your photos so you can add pictures of your property.",
          "cameraPermission": "HOSTELL uses the camera so you can take photos of your property and rooms.",
          "microphonePermission": false
        }
      ],
      "@react-native-google-signin/google-signin",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
