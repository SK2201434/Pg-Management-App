{
  "expo": {
    "name": "HOSTELL",
    "slug": "my-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/hostell-app-icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F3FBF7",
        "foregroundImage": "./assets/images/hostell-app-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.hostel.in",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/assets/Hostell_Logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3FBF7",
          "image": "./assets/images/assets/Hostell_Logo.png",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "HOSTELL uses your location to fill in your property's address."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "HOSTELL needs access to your photos so you can add pictures of your property.",
          "cameraPermission": "HOSTELL uses the camera so you can take photos of your property and rooms.",
          "microphonePermission": false
        }
      ],
      "@react-native-google-signin/google-signin",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "d7403de8-d5ec-4905-933b-212dc3f836d7"
      }
    },
    "owner": "hostell"
  }
}
