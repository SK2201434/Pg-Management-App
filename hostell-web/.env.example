# Copy to `.env.local` for local development. Never commit `.env.local` or any real credential.
# These are SERVER-ONLY variables: do not prefix any of them with NEXT_PUBLIC_.

# Firebase project that holds the existing `publicListings` collection.
FIREBASE_PROJECT_ID=hostell-685b3

# Local development, option 1 (preferred): path to a service-account JSON file kept OUTSIDE this
# repository, for example C:/Users/YOU/.secrets/hostell-web-admin.json. Create the key in
# Firebase Console > Project settings > Service accounts, preferably for a service account that
# only has read access to Firestore.
# FIREBASE_SERVICE_ACCOUNT_PATH=

# Local development, option 2: the same values as individual variables. Keep the private key on
# one line with literal \n sequences.
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# Deployed environments on Google Cloud (Cloud Run and similar): set only FIREBASE_PROJECT_ID.
# The runtime's Application Default Credentials are used.
# Locally you can also run: gcloud auth application-default login

# Seconds a CDN may cache a public listings page (0 disables caching, max 3600). Default 60.
# PUBLIC_LISTINGS_CACHE_SECONDS=60

# The public address of the deployed site, with no trailing path, for example https://www.example.com.
# It is used for canonical links, social previews, structured data, robots.txt and sitemap.xml.
# Set it in production; it falls back to http://localhost:3000.
# SITE_URL=

# Public (browser-visible) destination for the "Download the app" buttons, e.g. a store listing or
# a landing page. Leave unset until the app is published: the site then shows "Coming soon".
# NEXT_PUBLIC_APP_DOWNLOAD_URL=

# Firebase web API key for the email verification page (/auth/action). A public client identifier,
# not a secret, so the NEXT_PUBLIC_ prefix is intended. Firebase Console > Project settings > Your apps.
# NEXT_PUBLIC_FIREBASE_API_KEY=
